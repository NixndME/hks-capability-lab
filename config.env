# HKS Capability Lab configuration
#
# Copy to config.env and edit before running ./run-hks-test.sh:
#   cp config.env.example config.env
#
# Every value here is substituted into hks-capability-lab.yaml and
# manifests/*.yaml via envsubst — nothing cluster-specific is hard-coded in
# the YAML itself.

# Namespace used exclusively by this test suite. Never reused for anything
# else; run-hks-test.sh --cleanup only ever touches resources in here.
NAMESPACE=hks-capability-lab

# Domain / host used for Ingress-based access tests. This does NOT need to
# already resolve to this cluster — run-hks-test.sh tells you exactly what
# DNS record (or curl --resolve / Host-header workaround) is required based
# on what it discovers about the cluster's actual network reachability.
TEST_DOMAIN=example.com
TEST_HOST=hks-demo.lab.local

# StorageClass used for the storage validation test (manifests/storage-test.yaml).
# Leave as "auto" and run-hks-test.sh will pick the cluster's default
# StorageClass, or the only StorageClass if there's exactly one.
STORAGE_CLASS=rook-ceph-block

# IngressClass to route through for Ingress/canary tests.
# Leave as "auto" and run-hks-test.sh discovers it (see NETWORKING_DECISION.md
# for how the choice is made on a given cluster).
INGRESS_CLASS=nginx

# Base container image for the sample app: a stock, stdlib-only Python image.
# No custom build or private registry is required — the app code is mounted
# from a ConfigMap, not baked into the image.
APP_IMAGE=python:3.12-alpine

# Starting replica count for the main Deployment.
APP_REPLICAS=3

# Auto-discovered by run-hks-test.sh from `kubectl get prometheus -A`.
# Needed so Prometheus's ServiceAccount can be granted read access to this
# namespace's Services/Endpoints/Pods (see PROMETHEUS_VALIDATION.md).
PROMETHEUS_NAMESPACE=monitoring
PROMETHEUS_SERVICEACCOUNT=prometheus-k8s
