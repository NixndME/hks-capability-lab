# Config for deploying the PORTAL ITSELF (not the sample workload it
# validates -- that's manifests/ + hks-capability-lab.yaml). Copy to
# portal.env and edit.
#
#   cp deploy/portal/portal.env.example deploy/portal/portal.env
#   set -a && source deploy/portal/portal.env && set +a
#   envsubst < deploy/portal/portal.yaml | kubectl apply -f -

PORTAL_NAMESPACE=hks-portal
PORTAL_IMAGE=docker.io/nixndme/hks-capability-lab:1.0.0
PORTAL_DOMAIN=hks.nixndme.com
PORTAL_INGRESS_CLASS=nginx
PORTAL_REPLICAS=2
